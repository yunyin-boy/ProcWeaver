{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcWeaver",
  "version": "2.3.4",
  "identifier": "com.procweaver.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:next",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build:next",
    "frontendDist": "../dist-next"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "defaults": "defaults",
      "../licenses/hyper-LICENSE-MIT.txt": "licenses/hyper-LICENSE-MIT.txt",
      "../licenses/hyper-util-LICENSE-MIT.txt": "licenses/hyper-util-LICENSE-MIT.txt",
      "../licenses/http-body-util-LICENSE-MIT.txt": "licenses/http-body-util-LICENSE-MIT.txt",
      "../licenses/httpdate-LICENSE-MIT.txt": "licenses/httpdate-LICENSE-MIT.txt",
      "../licenses/base64-LICENSE-MIT.txt": "licenses/base64-LICENSE-MIT.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProcWeaver",
        "visible": false,
        "width": 1160,
        "height": 740,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "tray-menu",
        "title": "ProcWeaver Menu",
        "url": "index.html?window=tray-menu",
        "visible": false,
        "width": 500,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
